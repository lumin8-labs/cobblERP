# Database (Neon PostgreSQL connection string)
# Get your free serverless Postgres connection string at https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NestJS API Port
PORT=4000

# Next.js Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth Configuration
# Generate a secure secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="cobblerp-insecure-dev-secret-key-change-in-prod-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email Delivery (Resend API for Email OTP, verification & password reset)
# When omitted in local development, OTP codes are logged to the server console.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
AUTH_EMAIL_FROM="CobblERP <onboarding@resend.dev>"

# Dodo Payments (Merchant of Record & Payments Partner with UPI support)
# Get your keys from Dodo Payments Dashboard (https://app.dodopayments.com)
DODO_PAYMENTS_API_KEY="test_dodo_api_key_xxxxxxxxxxxxx"
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# Dodo Payments Product IDs (Footwear SaaS Subscription Tiers)
DODO_PRODUCT_STARTER_ID="pdt_starter_sample_id"
DODO_PRODUCT_PRO_ID="pdt_pro_sample_id"
DODO_PRODUCT_ENTERPRISE_ID="pdt_enterprise_sample_id"
